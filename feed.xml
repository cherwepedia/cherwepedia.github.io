---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="ru">
  <title>{{ site.title | xml_escape }} — новые статьи</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url | uri_escape | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  {%- assign feed_first = site.posts | first %}
  <updated>{{ feed_first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.title | xml_escape }}</name></author>
{%- for p in site.posts limit: 30 %}
  {%- include plain-text.html text=p.intro length=300 %}
  <entry>
    <title>{{ p.title | xml_escape }}</title>
    <link href="{{ p.url | absolute_url | uri_escape | xml_escape }}" rel="alternate" type="text/html"/>
    <id>{{ p.url | absolute_url | uri_escape | xml_escape }}</id>
    <published>{{ p.date | date_to_xmlschema }}</published>
    <updated>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</updated>
    <summary>{{ plain_text | xml_escape }}</summary>
    {%- for c in p.categories %}
    <category term="{{ c | xml_escape }}"/>
    {%- endfor %}
  </entry>
{%- endfor %}
</feed>
